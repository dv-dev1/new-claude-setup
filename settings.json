{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "mcp__claude_ai_Gmail",
      "mcp__claude_ai_Google_Calendar",
      "mcp__claude_ai_Claude_Docs"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "statusLine": {
    "type": "command",
    "command": "if command -v ccstatusline >/dev/null; then ccstatusline; else npx -y ccstatusline@2.2.32; fi",
    "padding": 0
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/sem-assinatura.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/lembretes.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$HOME/.claude/hooks/caveman.md\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c 'import json,os;print(json.dumps({\"hookSpecificOutput\":{\"hookEventName\":\"SubagentStart\",\"additionalContext\":open(os.path.expanduser(\"~/.claude/hooks/caveman.md\"),encoding=\"utf-8\").read()}}))'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/varredura.py\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$HOME/.claude/hooks/compactar.txt\""
          }
        ]
      }
    ]
  },
  "theme": "dark",
  "tui": "fullscreen",
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "caveman@caveman": false,
    "superpowers@superpowers-marketplace": true
  },
  "outputStyle": "default",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "model": "opus",
  "skillOverrides": {
    "anthropic-skills:morning": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:computer-use": "off",
    "code-review": "user-invocable-only",
    "simplify": "user-invocable-only",
    "loop": "user-invocable-only",
    "schedule": "user-invocable-only",
    "init": "user-invocable-only",
    "security-review": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "plugin-authoring": "user-invocable-only",
    "run": "user-invocable-only",
    "anthropic-skills:skill-creator": "user-invocable-only",
    "anthropic-skills:docs": "user-invocable-only",
    "anthropic-skills:docx": "user-invocable-only",
    "anthropic-skills:pptx": "user-invocable-only"
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-2": {
      "effortLevel": "medium"
    }
  },
  "switchModelsOnFlag": true,
  "teammateMode": "auto",
  "autoCompactWindow": 350000,
  "skillListingBudgetFraction": 0.03
}
