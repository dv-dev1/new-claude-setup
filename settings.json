{
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "skipDangerousModePermissionPrompt": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "statusLine": {
    "type": "command",
    "command": "if command -v ccstatusline >/dev/null; then ccstatusline; else npx -y ccstatusline@2.2.32; fi",
    "padding": 0
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"$HOME/.claude/hooks/sem-assinatura.py\"" }
        ]
      }
    ]
  },
  "theme": "dark",
  "tui": "fullscreen"
}
